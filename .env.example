# Copia este archivo a .env y rellena los valores

# Discord Application (https://discord.com/developers/applications)
CLIENT_ID=tu_client_id
CLIENT_SECRET=tu_client_secret

# URL pública del panel + /auth/callback
# Local:  http://localhost:3000/auth/callback
# Online: https://tu-dominio.com/auth/callback
# DEBE coincidir EXACTO en Discord Developer Portal → OAuth2 → Redirects
REDIRECT_URI=http://localhost:3000/auth/callback

# Token del bot (Bot → Reset Token)
BOT_TOKEN=tu_bot_token

# Secreto para las cookies de sesión (cualquier texto largo)
SESSION_SECRET=cambia-esto-por-algo-random-largo

# Puerto (opcional)
PORT=3000

# Solo si usas HTTPS y la cookie no se guarda: fuerza cookie segura
# COOKIE_SECURE=true
